---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MethodList from '../../components/MethodList.astro';
import PendingBlock from '../../components/PendingBlock.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const client = await getEntry(entry.data.client);
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
>
  <article>
    <header class="page-hero wrap reveal">
      <p class="eyebrow">
        <a href="/work/" style="color: inherit; text-decoration: none;">Our Work</a>
        <span aria-hidden="true"> / </span>
        {client?.data.name ?? 'Client'}
      </p>
      <h1 style="margin-top: var(--space-3); max-width: 20ch;">{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <p class="mono" style="margin-top: var(--space-4); font-size: var(--text-xs); color: var(--ink-muted);">
        {entry.data.duration} · {entry.data.teamSize}
      </p>
    </header>

    {
      entry.data.figures.length > 0 && (
        <section class="wrap section-tight" style="padding-top: 0;" aria-label="Engagement scale">
          <dl class="figure-grid">
            {entry.data.figures.map((fig) => (
              <div class="figure">
                <dt>{fig.label}</dt>
                <dd>{fig.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section class="section section-surface" aria-labelledby="method-heading">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Methodology</p>
          <h2 id="method-heading">The technical substance is the work</h2>
          <p class="lede">
            A talent director recognizes these terms. We keep them — they are how rigor is
            demonstrated, not asserted.
          </p>
        </div>
        <MethodList methods={entry.data.methods} />
      </div>
    </section>

    {
      entry.data.phases.length > 0 && (
        <section class="section" aria-labelledby="phases-heading">
          <div class="wrap">
            <div class="section-head">
              <p class="eyebrow">Delivery</p>
              <h2 id="phases-heading">Phases</h2>
            </div>
            <ol class="phase-list">
              {entry.data.phases.map((phase, i) => (
                <li>
                  <h3>
                    <span class="mono" style="color: var(--ink-muted); font-size: var(--text-xs); margin-right: 0.5rem;">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {phase.name}
                  </h3>
                  <p>{phase.detail}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <section class="section section-surface" aria-labelledby="narrative-heading">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Context</p>
          <h2 id="narrative-heading">What we were asked to do</h2>
        </div>
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="outcome-heading">
      <div class="wrap" style="display: grid; gap: var(--space-5); max-width: 40rem;">
        <div class="section-head" style="margin-bottom: 0;">
          <p class="eyebrow">Results</p>
          <h2 id="outcome-heading">Outcome</h2>
        </div>
        {
          entry.data.outcome ? (
            <p style="font-size: var(--text-md);">{entry.data.outcome}</p>
          ) : (
            <PendingBlock
              label="Outcome pending"
              note="We currently hold no client outcome data for this engagement. When a verified result or attributed quote is available, it will appear here — we will not invent one."
            />
          )
        }
        {
          entry.data.testimonial?.pending !== false && !entry.data.testimonial?.quote && (
            <PendingBlock
              label="Testimonial pending"
              note="Attributed client quotes are not yet on file for this case."
            />
          )
        }
        {
          entry.data.testimonial?.quote && (
            <blockquote style="margin: 0; padding-left: var(--space-4); border-left: 2px solid var(--brand);">
              <p style="font-family: var(--font-display); font-size: var(--text-lg);">
                “{entry.data.testimonial.quote}”
              </p>
              {entry.data.testimonial.attribution && (
                <footer style="margin-top: var(--space-3); color: var(--ink-muted); font-size: var(--text-sm);">
                  — {entry.data.testimonial.attribution}
                </footer>
              )}
            </blockquote>
          )
        }
      </div>
    </section>

    <section class="section section-surface">
      <div class="wrap cluster">
        <a class="btn btn-primary" href="/contact/">Contact us</a>
        <a class="btn btn-ghost" href="/work/">Back to Our Work</a>
      </div>
    </section>
  </article>
</BaseLayout>
