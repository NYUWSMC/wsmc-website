---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TeamCard from '../components/TeamCard.astro';
import { getCollection, getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'team');
if (!page) throw new Error('Missing pages/team');
const { Content } = await render(page);

const members = (await getCollection('team'))
  .filter((m) => m.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const priorOrgs = [...new Set(members.map((m) => m.data.priorOrg))];
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHero
    title={page.data.headline ?? page.data.title}
    lede={page.data.lede}
  />

  <section class="section-tight wrap" style="padding-top: 0;">
    <div class="prose">
      <Content />
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="oversight-heading">
    <div class="wrap" style="display: grid; gap: var(--space-5); max-width: 42rem;">
      <div class="section-head" style="margin-bottom: 0;">
        <p class="eyebrow">Buyer questions</p>
        <h2 id="oversight-heading">Oversight and confidentiality</h2>
      </div>
      <ul class="split-list">
        <li>
          <h3 style="font-family: var(--font-sans); font-size: var(--text-md);">Faculty oversight</h3>
          <p style="color: var(--ink-muted);">
            Engagements sit under the Director of NYU’s I-O Psychology program. Student delivery
            does not mean unsupervised delivery.
          </p>
        </li>
        <li>
          <h3 style="font-family: var(--font-sans); font-size: var(--text-md);">Confidentiality</h3>
          <p style="color: var(--ink-muted);">
            Every consultant signs a confidentiality and IP agreement before receiving client
            material. NDA practice follows the client’s preferred form when they have one.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="team-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Current cohort</p>
        <h2 id="team-heading">Consultants</h2>
        <p class="lede">
          Names and headshots are being confirmed. Slots below already reserve space for photos —
          adding an image later does not change the layout. Prior employers reflect recent cohorts.
        </p>
      </div>

      <ul class="team-grid">
        {
          members.map((m) => (
            <TeamCard
              name={m.data.name}
              initials={m.data.initials}
              priorRole={m.data.priorRole}
              priorOrg={m.data.priorOrg}
              classYear={m.data.classYear}
              projectRole={m.data.projectRole}
              photo={m.data.photo}
            />
          ))
        }
      </ul>

      <div style="margin-top: var(--space-7); max-width: 40rem;">
        <h3 style="font-family: var(--font-sans); font-size: var(--text-sm); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: var(--space-3);">
          Recent cohort employers
        </h3>
        <p style="color: var(--ink-muted); font-size: var(--text-sm);">
          {priorOrgs.join(' · ')}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
