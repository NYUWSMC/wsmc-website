---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection, getEntry } from 'astro:content';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing pages/home');

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featuredClients = (await getCollection('clients')).filter((c) => c.data.featured);
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <PageHero
    eyebrow={home.data.eyebrow}
    title={home.data.headline ?? home.data.title}
    lede={home.data.lede}
    primaryCta={home.data.primaryCta}
    secondaryCta={home.data.secondaryCta}
  />

  {
    home.data.audiences && (
      <section class="section section-surface" aria-label="Who this is for">
        <div class="wrap">
          <div class="audience-grid">
            {home.data.audiences.map((a) => (
              <a class="audience-link" href={a.href}>
                <h2>{a.title}</h2>
                <p>{a.summary}</p>
                <span class="arrow">{a.cta} →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Practice areas</p>
        <h2 id="services-heading">Problems we are built to solve</h2>
      </div>
      <ul class="split-list">
        {
          services.map((s) => (
            <li>
              <div>
                <h3 style="font-family: var(--font-sans); font-size: var(--text-md); font-weight: 600;">
                  {s.data.title}
                </h3>
              </div>
              <p style="color: var(--ink-muted); max-width: 36rem;">{s.data.summary}</p>
            </li>
          ))
        }
      </ul>
      <p style="margin-top: var(--space-5);">
        <a href="/services/">All services →</a>
      </p>
    </div>
  </section>

  <section class="section section-surface" aria-labelledby="work-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Selected work</p>
        <h2 id="work-heading">Engagements we can stand behind</h2>
      </div>

      {
        home.data.quote && (
          <blockquote
            style="margin: 0 0 var(--space-7); padding: 0; max-width: 40rem; border: 0;"
          >
            <p
              style="font-family: var(--font-display); font-size: clamp(1.25rem, 2.5vw, 1.6rem); line-height: 1.45; font-weight: 400;"
            >
              “{home.data.quote.text}”
            </p>
            <footer
              style="margin-top: var(--space-4); font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.04em; color: var(--ink-muted);"
            >
              — {home.data.quote.attribution}
            </footer>
          </blockquote>
        )
      }

      <h3
        style="font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: var(--space-4);"
      >
        Recent clients
      </h3>
      <ul class="cluster" style="list-style: none; --cluster-gap: 0.75rem 1.5rem;">
        {
          featuredClients.map((c) => (
            <li class="mono" style="font-size: var(--text-sm); color: var(--ink);">
              {c.data.name}
            </li>
          ))
        }
      </ul>
      <p style="margin-top: var(--space-5);">
        <a href="/work/">Full client index →</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="cta-heading">
    <div class="wrap" style="display: grid; gap: var(--space-4); max-width: 40rem;">
      <p class="eyebrow">Next step</p>
      <h2 id="cta-heading" style="font-size: clamp(1.5rem, 3vw, 2rem);">
        If the problem is measurement, we should talk.
      </h2>
      <p class="lede">
        Typical engagements fall in the $3,000–13,000 range.
      </p>
      <div class="cluster">
        <a class="btn btn-primary" href="/contact/">Start a conversation</a>
        <a class="btn btn-ghost" href="/team/">Meet the practice</a>
      </div>
    </div>
  </section>
</BaseLayout>
