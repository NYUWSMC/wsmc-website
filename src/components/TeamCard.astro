---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name?: string;
  initials: string;
  priorRole: string;
  priorOrg: string;
  classYear: string;
  projectRole: string;
  photo?: ImageMetadata;
}

const { name, initials, priorRole, priorOrg, classYear, projectRole, photo } = Astro.props;
const displayName = name ?? 'Name pending';
---

<li class="team-card">
  {
    photo ? (
      <Image class="team-photo" src={photo} alt={`Portrait of ${displayName}`} widths={[320, 480]} sizes="(max-width: 720px) 45vw, 240px" />
    ) : (
      <div class="team-monogram" aria-hidden="true">
        {initials}
      </div>
    )
  }
  <div>
    <h3>{displayName}</h3>
    {!name && <p class="role"><span class="pending">Identity pending</span></p>}
    <p class="role">{projectRole} · {classYear}</p>
    <p class="prior">
      <span class="mono" style="font-size: var(--text-xs); color: var(--ink-muted);">Prior · </span>
      {priorOrg}
      {
        priorRole !== 'Prior experience pending confirmation' && (
          <>
            <br />
            <span style="color: var(--ink-muted);">{priorRole}</span>
          </>
        )
      }
    </p>
  </div>
</li>
