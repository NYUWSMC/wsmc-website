---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  role: string;
  linkedin?: string;
  initials?: string;
  photo?: ImageMetadata;
}

const { name, role, linkedin, initials, photo } = Astro.props;
const monogram =
  initials ??
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');
---

<li class="team-card">
  {
    photo ? (
      <Image
        class="team-photo"
        src={photo}
        alt={`Portrait of ${name}`}
        widths={[320, 480]}
        sizes="(max-width: 720px) 45vw, 240px"
      />
    ) : (
      <div class="team-monogram" aria-hidden="true">
        {monogram}
      </div>
    )
  }
  <div>
    <h3>{name}</h3>
    <p class="role">{role}</p>
    {
      linkedin && (
        <p class="team-link">
          <a href={linkedin} rel="noopener noreferrer" target="_blank">
            LinkedIn
          </a>
        </p>
      )
    }
  </div>
</li>
